# Web access
APP_PORT=80
API_PORT=8080

# Change these before exposing the system to the Internet.
MYSQL_ROOT_PASSWORD=root123
JWT_SECRET=change-this-to-a-long-random-string
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
CLICKHOUSE_PASSWORD=change-this-clickhouse-password

# Public application images
MYSQL_IMAGE=shizr/medicine-bigdata:mysql-1.1.0
BACKEND_IMAGE=shizr/medicine-bigdata:backend-1.0.0
FRONTEND_IMAGE=shizr/medicine-bigdata:frontend-1.1.0
HADOOP_IMAGE=shizr/medicine-bigdata:hadoop-3.4.1

# Docker Hub mirror. Change to docker.io if this mirror is unavailable.
DOCKER_REGISTRY=m.daocloud.io/docker.io

# Use localhost unless Kafka needs to be accessed from another computer.
PUBLIC_HOST=localhost
MYSQL_PORT=3307
REDIS_PORT=6379
KAFKA_PORT=9092
FLINK_UI_PORT=8081
HDFS_UI_PORT=9870
HDFS_RPC_PORT=9003
YARN_UI_PORT=8088
MAPRED_UI_PORT=19888
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
